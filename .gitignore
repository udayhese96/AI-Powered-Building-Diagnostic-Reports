*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments & Secrets ---
.venv/
venv/
ENV/
env/
.env
pip-log.txt
pip-delete-this-directory.txt

# --- PDF Inputs (Unwanted / Sensitive Source Documents) ---
*.pdf
**/*.pdf

# --- Compiled Reports & Dynamic Outputs (Word Documents) ---
*.docx
**/*.docx
DDR_Report_*.docx
!templates/*.docx

